dat$n_trials <- 100L
dat$n_old <- rsdt_binary(nrow(dat), dat$n_trials, dat$stimulus,
                         d = 1.5, criterion = 0.2)

model <- sdt_binary(
  response = "n_old",
  stimulus = "stimulus",
  n_trials = "n_trials"
)

fit <- bmm(
  formula = bmf(d ~ 1, criterion ~ 1),
  data = dat,
  model = model,
  cores = 4,
  backend = "cmdstanr"
)

# Unequal-variance binary SDT
fit_uv <- bmm(
  formula = bmf(d ~ 1, criterion ~ 1, sdratio ~ 1),
  data = dat,
  model = model,
  cores = 4,
  backend = "cmdstanr"
)
}
