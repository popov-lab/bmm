# simulate a visual working memory task and a speed task for the same subjects
dat_vwm <- data.frame(
  id = factor(rep(1:20, each = 50)),
  error = rmixture2p(1000, kappa = 8, p_mem = 0.8)
)
dat_speed <- data.frame(
  id = factor(rep(1:20, each = 50)),
  rt = rlnorm(1000, meanlog = -0.5, sdlog = 0.3)
