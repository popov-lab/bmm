  bmf(thetat ~ 1 + (1 | p | id), kappa ~ 1 + (1 | p | id)),
  model = mixture2p(resp_error = "error"),
  data = dat_vwm
) +
  bmm_component(
    bmf(rt ~ 1 + (1 | p | id)),
    family = brms::lognormal(),
    data = dat_speed
